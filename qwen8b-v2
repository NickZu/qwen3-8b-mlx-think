def read_excel_vote_data(excel_path):
    """读取Excel，返回字典：{票号: [业主信息1, 业主信息2, ...]}"""
    df = pd.read_excel(excel_path)
    vote_dict = {}
    for _, row in df.iterrows():
        vote_no = str(row[EXCEL_KEY_COLUMNS["票号"]]).strip()
        owner_info = {
            "姓名": str(row[EXCEL_KEY_COLUMNS["业主姓名"]]).strip(),
            "身份证": str(row[EXCEL_KEY_COLUMNS["身份证号"]]).strip(),
            "投票原文": str(row[EXCEL_KEY_COLUMNS["投票内容"]]).strip() if pd.notna(row[EXCEL_KEY_COLUMNS["投票内容"]]) else ""
        }
        if vote_no not in vote_dict:
            vote_dict[vote_no] = []
        vote_dict[vote_no].append(owner_info)
    return vote_dict

def read_all_txt_files(folder_path):
    """读取文件夹内所有txt文件，返回按票号分组的字典：{票号: [文件信息列表]}"""
    files_by_vote = {}
    for filename in os.listdir(folder_path):
        if filename.endswith(".txt"):
            # 提取票号（第一个下划线前的内容）
            vote_no = filename.split("_")[0]
            # 提取时间戳（第二个部分，格式如20260118091256）
            parts = filename.split('_')
            timestamp_str = parts[1] if len(parts) > 1 else "0"
            try:
                timestamp = datetime.strptime(timestamp_str, "%Y%m%d%H%M%S")
            except:
                timestamp = datetime.min  # 解析失败则设为最小值
            file_path = os.path.join(folder_path, filename)
            with open(file_path, encoding="utf-8") as f:
                content = f.read().strip()
            file_info = {
                "文件名": filename,
                "时间戳": timestamp,
                "文本内容": content
            }
            if vote_no not in files_by_vote:
                files_by_vote[vote_no] = []
            files_by_vote[vote_no].append(file_info)
    return files_by_vote

def clean_transcription(text):
    """清洗语音转译文本：去除连续重复字符、常见口语填充词、合并多余空格"""
    # 去除连续重复字符（至少3次）
    text = re.sub(r'(.)\1{2,}', r'\1', text)
    # 移除常见填充词（可扩展）
    fillers = ['嗯', '啊', '那个', '这个', '就是说', '然后呢', '就是', '呃', '哦', '哈']
    for filler in fillers:
        text = text.replace(filler, '')
    # 合并多余空格
    text = re.sub(r'\s+', ' ', text).strip()
    return text

def call_model_with_prompt(user_content):
    """使用新版MLX-LM API调用模型，返回原始响应字符串"""
    messages = [
        {"role": "system", "content": SYSTEM_PROMPT},
        {"role": "user", "content": user_content}
    ]
    prompt = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
    
    # 创建采样器，temp=0 保证确定性输出
    sampler = make_sampler(temp=0)
    
    response = generate(
        model,
        tokenizer,
        prompt=prompt,
        max_tokens=1000,          # 增加到1000，确保长文本完整输出
        sampler=sampler,
        verbose=False
    )
    return response

def clean_response(response):
    """清理响应中的控制字符和多余空格"""
    # 移除控制字符
    response = re.sub(r'[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]', '', response)
    # 将多个空格替换为单个空格（保留换行以便JSON解析）
    response = re.sub(r'[ \t]+', ' ', response).strip()
    return response

def extract_json_from_response(response):
    """
    从模型响应中提取JSON对象，支持多种格式。
    返回解析后的字典，或None
    """
    # 先清理响应
    response = clean_response(response)
    
    # 尝试直接解析整个响应
    try:
        return json.loads(response)
    except:
        pass
    
    # 尝试匹配被 ```json``` 包裹的代码块
    code_block_match = re.search(r'```(?:json)?\s*(\{.*?\})\s*```', response, re.DOTALL | re.IGNORECASE)
    if code_block_match:
        try:
            return json.loads(code_block_match.group(1))
        except:
            pass
    
    # 尝试查找第一个 { 到最后一个 } 之间的内容（考虑嵌套括号）
    stack = []
    start = -1
    end = -1
    for i, ch in enumerate(response):
        if ch == '{':
            if not stack:
                start = i
            stack.append(ch)
        elif ch == '}':
            if stack:
                stack.pop()
                if not stack:
                    end = i
                    json_str = response[start:end+1]
                    try:
                        return json.loads(json_str)
                    except:
                        # 如果解析失败，重置并继续寻找下一个可能的JSON
                        start = -1
                        end = -1
    return None

def compute_match_score(owner, extracted_name, extracted_id, extracted_phone_last4=None):
    """计算业主与提取信息的匹配分数（加权）"""
    score = 0
    # 姓名相似度（拼音 + 原始文本）
    if extracted_name and owner["姓名"]:
        owner_py = ''.join(lazy_pinyin(owner["姓名"]))
        ext_py = ''.join(lazy_pinyin(extracted_name))
        score += fuzz.ratio(owner_py, ext_py) * 0.6
        score += fuzz.ratio(owner["姓名"], extracted_name) * 0.4
    # 身份证后四位匹配（优先级高）
    if extracted_id and owner["身份证"].endswith(extracted_id):
        score += 100
    # 手机号后四位匹配（若有）
    if extracted_phone_last4 and owner.get("手机号") and str(owner["手机号"]).endswith(extracted_phone_last4):
        score += 80
    return score

def parse_model_response(response, excel_owners, vote_no=None, filename=None):
    """
    解析模型返回的JSON，并尝试匹配业主。
    返回：解析后的字典（包含matched_owner和match_score字段）或None（解析失败）
    """
    # 提取JSON
    res = extract_json_from_response(response)
    if res is None:
        # 确保日志目录存在
        log_dir = os.path.dirname(LOG_FILE_PATH)
        if log_dir and not os.path.exists(log_dir):
            os.makedirs(log_dir, exist_ok=True)
        # 调试：保存原始响应到日志（带上票号和文件名）
        with open(LOG_FILE_PATH, "a", encoding="utf-8") as f:
            f.write(f"票号: {vote_no} 文件: {filename} 解析失败的响应:\n{response}\n{'-'*50}\n")
        return None

    # 确保关键字段存在且为字典
    if "call_status" not in res:
        res["call_status"] = "未知"
    
    # 处理 identity
    identity = res.get("identity")
    if identity is None or not isinstance(identity, dict):
        identity = {}
        res["identity"] = identity
    # 确保 identity 子字段存在
    identity.setdefault("name", None)
    identity.setdefault("id_last4", None)
    identity.setdefault("self_claim", "未明确")
    
    # 处理 vote_intent（应为数组）
    vote_intent = res.get("vote_intent")
    if vote_intent is None:
        vote_intent = []
        res["vote_intent"] = vote_intent
    elif not isinstance(vote_intent, list):
        # 兼容旧版本可能的对象格式，转换为列表
        if isinstance(vote_intent, dict):
            vote_intent = [vote_intent]
        else:
            vote_intent = []
    # 确保每个元素是字典，且包含item和choice
    for item in vote_intent:
        if not isinstance(item, dict):
            continue
        item.setdefault("item", None)
        item.setdefault("choice", None)
    
    # 身份匹配（加权计算）
    matched_owner = None
    best_score = 0
    extracted_name = identity.get("name")
    extracted_id = identity.get("id_last4")
    # 可选：从文本中提取手机后四位（如果模型提供了，此处未要求模型提供，暂时忽略）
    extracted_phone_last4 = None  # 可扩展

    if excel_owners and (extracted_name or extracted_id):
        for owner in excel_owners:
            score = compute_match_score(owner, extracted_name, extracted_id, extracted_phone_last4)
            if score > best_score:
                best_score = score
                matched_owner = owner

    # 设定阈值，60分以上认为匹配成功
    if best_score < 60:
        matched_owner = None

    res["matched_owner"] = matched_owner
    res["match_score"] = best_score if matched_owner else 0
    return res

def is_valid_vote(parsed):
    """
    根据解析结果判断投票是否有效。
    返回：(is_valid, reason)
    """
    if parsed is None:
        return False, "模型输出解析失败"
    
    # 通话状态异常直接无效
    if parsed.get("call_status") != "正常接通":
        return False, f"通话状态：{parsed.get('call_status')}"
    
    # 必须有投票意愿（vote_intent列表非空）
    intent = parsed.get("vote_intent", [])
    if not intent:
        return False, "无明确投票意愿"
    
    # 必须匹配到具体业主
    if parsed.get("matched_owner") is None:
        return False, "无法匹配业主身份"
    
    # 可选：与人工备注进行一致性检查（如果备注存在）
    owner = parsed["matched_owner"]
    manual_note = owner.get("投票原文", "")
    if manual_note:
        # 简单检查提取的关键词是否出现在备注中
        keywords = []
        for item in intent:
            if item.get("choice"):
                keywords.append(item["choice"])
        match_found = any(kw in manual_note for kw in keywords if kw)
        if not match_found:
            # 不一致，但仍算有效，但标记风险
            return True, "有效但人工备注不一致"
    
    return True, "有效投票"

def merge_file_results(file_results, vote_no):
    """
    合并同一票号下多个文件的解析结果，采用信息互补策略。
    file_results: 列表，每个元素为 {"文件名": str, "时间戳": datetime, "parsed": dict}
    返回合并后的最佳解析结果字典（包含合并后的字段），以及选用的文件名（用于记录）。
    """
    if not file_results:
        return None, ""

    # 初始化合并字段
    merged = {
        "call_status": None,
        "identity": {"name": None, "id_last4": None, "self_claim": None},
        "vote_intent": [],
        "explanation": "",
        "matched_owner": None,
        "match_score": 0,
    }
    best_vote_intent = None
    best_vote_timestamp = None
    best_vote_filename = None
    best_explanation = ""
    best_owner = None
    best_owner_score = 0
    best_owner_filename = None
    best_call_status = None

    for res in file_results:
        parsed = res["parsed"]
        if parsed is None:
            continue
        ts = res["时间戳"]
        fname = res["文件名"]

        # 更新通话状态：只要有一个正常接通，最终状态即为正常接通
        if parsed.get("call_status") == "正常接通":
            merged["call_status"] = "正常接通"
        elif merged["call_status"] is None:
            merged["call_status"] = parsed.get("call_status", "未知")

        # 更新身份：取匹配分数最高的业主
        owner = parsed.get("matched_owner")
        score = parsed.get("match_score", 0)
        if owner and score > best_owner_score:
            best_owner_score = score
            best_owner = owner
            best_owner_filename = fname

        # 更新投票意向：优先采用正常接通且有投票意向的文件，其次取任何有投票意向的文件
        intent = parsed.get("vote_intent", [])
        if intent:
            if parsed.get("call_status") == "正常接通":
                # 正常接通的投票意向优先
                if best_vote_intent is None or ts > best_vote_timestamp:
                    best_vote_intent = intent
                    best_vote_timestamp = ts
                    best_vote_filename = fname
                    best_explanation = parsed.get("explanation", "")
            else:
                # 如果没有正常接通的，则使用第一个异常文件中的投票意向（按时间顺序）
                if best_vote_intent is None:
                    best_vote_intent = intent
                    best_vote_timestamp = ts
                    best_vote_filename = fname
                    best_explanation = parsed.get("explanation", "")

    # 设置最终合并结果
    if best_owner:
        merged["matched_owner"] = best_owner
        merged["match_score"] = best_owner_score
        # 身份信息从 matched_owner 中提取
        merged["identity"]["name"] = best_owner.get("姓名")
        # 身份证后四位可以从owner中获取（但最好保持与模型输出一致，此处若模型输出了则可能覆盖）
        # 但身份信息以匹配结果为准，不再使用模型输出的identity（因为模型可能有误）
        # 若模型输出的身份证后四位与匹配到的业主一致，可保留；否则使用匹配业主的身份证后四位
        # 简化处理：保留模型identity中的id_last4，但实际匹配时我们使用的是owner的身份证后四位，这里可保持原样
        # 我们这里将匹配到的业主姓名填入identity.name
        merged["identity"]["name"] = best_owner.get("姓名")
        # id_last4 可以从owner的身份证后四位取
        if best_owner.get("身份证"):
            merged["identity"]["id_last4"] = best_owner["身份证"][-4:]
    else:
        # 如果没有匹配到业主，可能从模型输出中获取身份信息
        # 取第一个有identity信息的文件
        for res in file_results:
            parsed = res["parsed"]
            if parsed and parsed.get("identity"):
                merged["identity"] = parsed["identity"]
                break

    # 设置投票意向和说明
    if best_vote_intent:
        merged["vote_intent"] = best_vote_intent
        merged["explanation"] = best_explanation
        selected_file = best_vote_filename
    else:
        selected_file = best_owner_filename if best_owner_filename else (file_results[0]["文件名"] if file_results else "")

    # 如果最终状态仍为None，则设为"未知"
    if merged["call_status"] is None:
        merged["call_status"] = "未知"

    return merged, selected_file

def process_vote_no(vote_no, file_list, excel_owners, cache):
    """
    处理单个票号下的所有文件，使用缓存避免重复调用模型，然后合并信息。
    返回最终结果字典。
    """
    file_results = []
    for file_info in file_list:
        filename = file_info["文件名"]
        raw_content = file_info["文本内容"]
        
        # 文本预处理：清洗噪声
        txt_content = clean_transcription(raw_content)
        
        # 缓存：如果内容哈希相同，复用解析结果
        content_hash = hashlib.md5(txt_content.encode()).hexdigest()
        if content_hash in cache:
            parsed = cache[content_hash]
            # 注意：缓存的结果不含文件名和时间戳，需重新关联
        else:
            # 构建用户消息
            user_content = f"录音文本：{txt_content}\n"
            if excel_owners:
                owner_names = [o["姓名"] for o in excel_owners]
                user_content += f"可能的业主：{', '.join(owner_names)}\n"
            # 添加人工备注作为参考
            manual_note = ""
            if excel_owners:
                for owner in excel_owners:
                    if owner.get("投票原文"):
                        manual_note = owner["投票原文"]
                        break
            if manual_note:
                user_content += f"【参考信息】物业方记录该业主的投票意向可能为：{manual_note}（请以录音为准，此信息仅作参考）。\n"
            user_content += "不要输出任何思考过程，直接输出JSON，不要包含```json标记，也不要任何解释。"
            
            # 调用模型
            model_response = call_model_with_prompt(user_content)
            
            # 解析并匹配
            parsed = parse_model_response(model_response, excel_owners, vote_no=vote_no, filename=filename)
            # 存入缓存
            if parsed is not None:
                # 注意：缓存的是解析结果，但不含时间戳和文件名，这些是动态的，不缓存
                cache[content_hash] = parsed
        
        if parsed:
            # 添加时间戳，用于后续排序
            parsed["_timestamp"] = file_info["时间戳"]
        
        file_results.append({
            "文件名": filename,
            "时间戳": file_info["时间戳"],
            "parsed": parsed
        })
    
    # 合并信息，得到最终结果
    merged_parsed, selected_file = merge_file_results(file_results, vote_no)
    
    if merged_parsed is None:
        return {
            "票权编号": vote_no,
            "最终选用文件": "",
            "匹配业主": "",
            "匹配分数": 0,
            "投票状态": "无效",
            "风险备注": "无可用录音文件",
            "推理说明": "",
            "模型输出": ""
        }
    
    # 判断投票有效性
    is_valid, reason = is_valid_vote(merged_parsed)
    
    matched_owner = merged_parsed.get("matched_owner")
    matched_name = matched_owner.get("姓名", "") if matched_owner else ""
    explanation = merged_parsed.get("explanation", "")
    match_score = merged_parsed.get("match_score", 0)
    
    # 准备模型输出（用于保存）
    # 创建一个不含 _timestamp 的副本
    parsed_copy = merged_parsed.copy()
    parsed_copy.pop("_timestamp", None)
    # 将 matched_owner 转换为可JSON序列化的形式（仅保留必要字段）
    if "matched_owner" in parsed_copy:
        owner = parsed_copy["matched_owner"]
        if owner:
            parsed_copy["matched_owner"] = {
                "姓名": owner.get("姓名"),
                "身份证后四位": owner.get("身份证", "")[-4:] if owner.get("身份证") else None
            }
        else:
            parsed_copy["matched_owner"] = None
    model_output_dump = json.dumps(parsed_copy, ensure_ascii=False)
    
    return {
        "票权编号": vote_no,
        "最终选用文件": selected_file,
        "匹配业主": matched_name,
        "匹配分数": match_score,
        "投票状态": "有效" if is_valid else "无效",
        "风险备注": reason,
        "推理说明": explanation,
        "模型输出": model_output_dump
    }

